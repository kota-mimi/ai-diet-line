{
  "name": "healthy-kun-functions",
  "version": "1.0.0",
  "description": "Firebase Functions for Healthy-kun LINE Bot and AI Health Service",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.0.1",
    "@line/bot-sdk": "^9.7.0",
    "@google/generative-ai": "^0.24.1",
    "stripe": "^19.3.1",
    "nodemailer": "^7.0.10",
    "sharp": "^0.34.4",
    "html2canvas": "^1.4.1",
    "date-fns": "^4.1.0",
    "uuid": "^13.0.0",
    "dotenv": "^17.2.3",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@types/nodemailer": "^7.0.3"
  },
  "private": true
}